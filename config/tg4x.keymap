#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB   &kp Q    &kp W    &kp E       &kp R &kp T &kp Y &kp U    &kp I     &kp O    &kp P    &kp APOS  &kp BSPC
&kp LCTRL &kp A    &kp S    &kp D       &kp F &kp G &kp H &kp J    &kp K     &kp L    &kp SEMI           &kp RET
&kp LSHFT &kp Z    &kp X    &kp C       &kp V &kp B &kp N &kp M    &kp COMMA &kp DOT  &kp SLASH          &kp RSHFT
&kp LGUI  &kp LALT &mo 2    &lt 2 SPACE                   &kp SPACE &mo 1    &kp RALT &mo 2              &kp RCTRL
            >;
        };

        number_layer {
            bindings = <
&trans &kp GRAVE &none  &none  &none  &none  &none  &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &trans
&none  &kp N1    &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7    &kp N8    &kp N9   &kp N0            &trans
&trans &trans    &trans &trans &trans &trans &trans &trans    &trans    &trans   &trans            &trans
&trans &trans    &trans &trans                      &trans    &trans    &trans   &trans            &trans
            >;
        };

        symbol_layer {
            bindings = <
&trans &kp RS(GRAVE) &trans     &trans     &trans     &trans     &trans     &kp LS(MINUS) &kp LS(EQUAL) &kp LS(LBKT) &kp LS(RBKT) &kp LS(BSLH) &trans
&none  &kp RS(N1)    &kp RS(N2) &kp RS(N3) &kp RS(N4) &kp RS(N5) &kp LS(N6) &kp LS(N7)    &kp LS(N8)    &kp LS(N9)   &kp LS(N0)                &trans
&trans &trans        &trans     &trans     &trans     &trans     &trans     &trans        &trans        &trans       &trans                    &trans
&trans &trans        &trans     &trans                                      &trans        &trans        &trans       &trans                    &trans
            >;
        };

        navigation_layer {
            bindings = <
&trans &kp ESC      &kp C_AL_EMAIL &kp C_AL_JOURNAL &kp C_AL_NEWS &kp C_AL_MUSIC &kp PG_UP &kp HOME &kp UP   &kp END   &kp DEL &none &trans
&none  &kp C_AL_WWW &kp C_AL_CAL   &kp C_AC_BACK    &kp C_AC_HOME &kp C_AL_CALC  &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp INS       &trans
&trans &trans       &trans         &trans           &trans        &trans         &trans    &trans   &trans   &trans    &trans        &trans
&trans &trans       &trans         &trans                                                  &trans   &trans   &trans    &trans       &trans
            >;
        };

    };
};
