#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Base";
            bindings = <
                &kp ESC   &kp Q        &kp W        &kp E        &kp R        &kp T      &kp Y        &kp U     &kp I     &kp O    &kp P       &kp BSPC
                &kp TAB   &kp A        &kp S        &kp D        &kp F        &kp G      &kp H        &kp J     &kp K     &kp L    &kp SEMI    &kp RET
                &kp LSHFT &kp Z        &kp X        &kp C        &kp V        &kp B      &kp N        &kp M     &kp COMMA &kp DOT  &kp SLASH   &kp RSHFT
                &kp LCTRL &kp LGUI     &kp LALT     &lt 1 SPACE                          &lt 2 SPACE            &kp LALT  &kp RGUI &kp K_CMENU &kp RCTRL
            >;
        };
        symbol { // Layer 1
            display-name = "Symbol";
            bindings = <
                &trans    &kp GRAVE    &none        &none        &none        &none      &none        &kp MINUS &kp EQUAL &kp LBKT &kp RBKT    &trans
                &none     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5     &kp N6       &kp N7    &kp N8    &kp N9   &kp N0      &trans
                &trans    &none        &none        &none        &none        &none      &none        &none     &none     &kp APOS &kp BSLH    &trans
                &trans    &trans       &trans       &to 0                                &lt 2 SPACE            &trans    &trans   &to 1       &trans
            >;
        };
        function { // Layer 2
            display-name = "Function";
            bindings = <
                &trans    &kp PG_UP    &kp UP       &kp PG_DN    &kp C_PREV   &kp C_PP   &kp C_NEXT   &kp F1    &kp F2    &kp F3   &kp F4      &trans
                &kp CAPS  &kp LEFT     &kp DOWN     &kp RIGHT    &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &kp F5    &kp F6    &kp F7   &kp F8      &trans
                &trans    &kp HOME     &kp END      &kp INS      &kp DEL      &kp PSCRN  &sl 3        &kp F9    &kp F10   &kp F11  &kp F12     &trans
                &trans    &trans       &trans       &lt 1 SPACE                          &to 0                  &trans    &trans   &to 2       &trans
            >;
        };
        bluetooth { // Layer 3
            display-name = "Bluetooth";
            bindings = <
                &trans    &none        &none        &none        &none        &none      &none        &none     &none     &none    &bt BT_CLR  &trans
                &none     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none      &none        &none     &none     &none    &none       &trans
                &trans    &none        &none        &none        &none        &none      &none        &none     &none     &none    &soft_off   &trans
                &trans    &trans       &trans       &lt 1 SPACE                          &lt 2 SPACE            &trans    &trans   &none       &trans
            >;
        };
    };
};